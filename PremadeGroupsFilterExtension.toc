## Interface: 120100
## Title: Ka0s Premade Groups Filter Extension
## Notes: Mythic+ conveniences for Premade Groups Filter: untimed-dungeon targeting, server regions, composition and leader filters, presets
## Author: add1kted2ka0s
## Version: 0.1.0
## IconTexture: Interface\AddOns\PremadeGroupsFilterExtension\media\logos\premadegroupsfilterextension.logo.128.tga
## SavedVariables: PremadeGroupsFilterExtensionDB
## Dependencies: PremadeGroupsFilter
## OptionalDeps: PremadeRegions, EllesmereUI, Ace3, LibStub, CallbackHandler-1.0, LibSharedMedia-3.0, LibDataBroker-1.1, LibDBIcon-1.0
## DefaultState: enabled
## Category-enUS: Group
## X-License: MIT
## X-Standard: https://github.com/tusharsaxena/WowAddonStandards
## X-Curse-Project-ID: 1736636

# Libraries (must load first) -- vendored in libs/, .xml where the lib ships one, else .lua
libs\LibStub\LibStub.lua
libs\CallbackHandler-1.0\CallbackHandler-1.0.lua
libs\AceAddon-3.0\AceAddon-3.0.lua
libs\AceEvent-3.0\AceEvent-3.0.lua
libs\AceConsole-3.0\AceConsole-3.0.lua
libs\AceDB-3.0\AceDB-3.0.lua
libs\AceGUI-3.0\AceGUI-3.0.xml
# LOAD-BEARING: AceConfigDialog-3.0.lua resolves AceGUI-3.0 with a non-silent LibStub at file load,
# so AceConfig-3.0.xml must sit below AceGUI-3.0.xml. AceDBOptions resolves nothing at load.
libs\AceConfig-3.0\AceConfig-3.0.xml
libs\AceDBOptions-3.0\AceDBOptions-3.0.lua
libs\LibSharedMedia-3.0\lib.xml
# Conventional: LibKa0s-Launcher-1.0 resolves both at Register time; LibDBIcon needs the two above it.
libs\LibDataBroker-1.1\LibDataBroker-1.1.lua
libs\LibDBIcon-1.0\LibDBIcon-1.0.lua
# ONE line: the .xml is itself the file list (library-stack-§7). After Ace3.
libs\LibKa0s\LibKa0s.xml

# Locales
# LOAD-BEARING: publishes NS.L, which core\CoreSetup.lua and every later file read at load.
locales\enUS.lua

# Core -- dependency-correct order (layout-§1)
# LOAD-BEARING: publishes NS.Util.print / NS.Print and NS.LIBKA0S_MISSING, read at load below.
core\CoreSetup.lua
# LOAD-BEARING: publishes NS.MediaFont, which core\PGFE.lua resolves NS.FONT_MONO from at load.
core\MediaSetup.lua
# Conventional: NS.Compat is read inside functions only.
core\Compat.lua
# Conventional: NS.Meta / NS.Version are read inside functions only.
core\EnvSetup.lua
# LOAD-BEARING: promotes NS to the AceAddon object (NS.addon) and publishes NS.PREFIX, NS.State,
# NS.FONT_MONO, NS.FEATURE_EVENTS, NS.STAND_DOWN and NS.STAND_UP; modules\EnvInject.lua,
# modules\Panel.lua, modules\EUISkin.lua and every settings\ file read NS.addon at load.
core\PGFE.lua
# Conventional: NS:RunMigrations is called from OnInitialize.
core\Database.lua
# LOAD-BEARING: after core\PGFE.lua (NS.FONT_MONO, NS.State), before any NS.Debug call site.
core\DebugLogSetup.lua
# Conventional: the launcher is built here and registered from OnEnable.
core\LauncherSetup.lua
# Conventional: publishes NS.Lifecycle, NS.IsStoodDown and NS.HOLD_DISABLED; every reader
# (core\PGFE.lua, the modules, settings\Panel.lua) reaches them at call time.
core\LifecycleSetup.lua
# Conventional: the PGF bridge; every PGF read happens at call time.
core\PGFBridge.lua
# Conventional: the EllesmereUI bridge; every EllesmereUI read happens at call time.
core\EUIBridge.lua

# Defaults
# LOAD-BEARING: publishes NS.C, which settings\Schema.lua takes as a file-scope upvalue.
defaults\Profile.lua
# Conventional: data only, read by modules\Regions.lua at call time.
defaults\Realms.lua

# Modules
# Conventional: publishes NS.Regions; reads NS.RealmLists (defaults\Realms.lua) at call time.
modules\Regions.lua
# Conventional: publishes NS.Season; reads the client's Mythic+ data at call time.
modules\Season.lua
# Conventional: publishes NS.Targeting; pure computation over the rows passed in at call time.
modules\Targeting.lua
# Conventional: publishes NS.Expression; pure string work at call time.
modules\Expression.lua
# Conventional: publishes NS.Filters; reads NS.addon.db and the other modules at call time.
modules\Filters.lua
# Conventional: publishes NS.Presets; reads NS.addon.db, NS.C and NS.Filters at call time.
modules\Presets.lua
# LOAD-BEARING: reads NS.addon, appends NS.FEATURE_EVENTS/NS.STAND_UP (core\PGFE.lua), calls
# NS.Bridge.InstallEnvHook (core\PGFBridge.lua) at load.
modules\EnvInject.lua
# Conventional (vs. addon files): hooks Blizzard Group Finder globals at load; reads NS.* at call time.
modules\RegionTags.lua
# Conventional: publishes NS.Apply; reads the other modules and NS.Bridge at call time.
modules\Apply.lua
# LOAD-BEARING: reads NS.L (locales\enUS.lua) and NS.addon, appends
# NS.FEATURE_EVENTS/NS.STAND_DOWN/NS.STAND_UP (core\PGFE.lua), calls NS.Bridge.HookDialog
# (core\PGFBridge.lua) at load.
modules\Panel.lua
# LOAD-BEARING: registers with EllesmereUI at file load (EllesmereUI is an OptionalDep, so it is
# loaded first when present) and reads NS.EUIBridge, published by core\EUIBridge.lua above. It also
# reads NS.L and NS.addon, and appends NS.FEATURE_EVENTS/NS.STAND_DOWN/NS.STAND_UP (core\PGFE.lua).
modules\EUISkin.lua
# Conventional: core\DebugLogSetup.lua's descriptor reads NS.Diagnostics at RUN time.
modules\Diagnostics.lua

# Settings (last -- depend on everything else being initialized)
# LOAD-BEARING: publishes Settings.SchemaLib, which settings\Schema.lua calls :New on at file scope.
settings\SchemaSetup.lua
# LOAD-BEARING: publishes Settings.Schema and NS.SchemaRuntime; settings\OptionsSetup.lua,
# settings\Panel.lua and settings\Slash.lua read NS.SchemaRuntime at load.
settings\Schema.lua
# LOAD-BEARING: publishes the LibKa0s-Options instance as Settings.Helpers; settings\Panel.lua calls
# Helpers.MasterControls at file scope.
settings\OptionsSetup.lua
# LOAD-BEARING: reads NS.addon, NS.C (defaults\Profile.lua), Settings.Helpers (settings\OptionsSetup.lua),
# NS.SchemaRuntime.AddRows and Settings.StampClosureRows (settings\Schema.lua) at file scope.
settings\Panel.lua
# LOAD-BEARING: captures NS.SchemaRuntime.Get/Set/FindRow/ApplyDefault (settings\Schema.lua) and
# NS.Version (core\EnvSetup.lua) at load.
settings\Slash.lua
# LAST, so its RegisterOptionsPage call queues behind General's (options-ui-§3).
settings\Profiles.lua
